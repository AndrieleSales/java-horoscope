comment12.target=void\ populateTulip()
comment12.text=\r\n\ Adds\ Tulip\ flower\ to\ signs\ and\ generates\ all\ the\ years\ \r\n\ by\ adding\ six\ years\ each\ time,\ starting\ from\ 1963\ inclusive.\r\n
